{
  "name": "@bajes/types",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Shared TypeScript types for Bajes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "dev": "tsc --watch --project tsconfig.json"
  },
  "devDependencies": {
    "@bajes/config": "workspace:*",
    "typescript": "^6.0.3",
    "rimraf": "^6.0.0"
  }
}
