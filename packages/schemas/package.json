{
  "name": "@bajes/schemas",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Zod validation schemas for Bajes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "dev": "tsc --watch --project tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@bajes/config": "workspace:*",
    "typescript": "^5.7.0",
    "rimraf": "^6.0.0"
  }
}
